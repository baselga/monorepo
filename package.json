{
  "name": "monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:ui": "npm run dev --workspace=@monorepo/ui-dev",
    "dev:ui-lib": "npm run dev --workspace=@monorepo/ui",
    "dev": "concurrently -n lib,app -c magenta,cyan \"npm:dev:ui-lib\" \"npm:dev:ui\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "engines": {
    "node": ">=v24.15.0",
    "npm": ">=11"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.0"
  }
}
